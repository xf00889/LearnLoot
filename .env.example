DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://course_deals:course_deals@127.0.0.1:5432/course_deals

CORS_ALLOWED_ORIGINS=http://localhost:3000

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Provider discovery. Keep access approval false until the provider's current
# terms, robots directives, and permitted automated-access method are reviewed.
LEARNLOOT_UDEMY_DISCOVERY_ACCESS_APPROVED=false
LEARNLOOT_UDEMY_DISCOVERY_SOURCE_URL=https://www.udemy.com/courses/free/
LEARNLOOT_UDEMY_DISCOVERY_MAX_PAGES=10
LEARNLOOT_UDEMY_DISCOVERY_ITEM_LIMIT=0
LEARNLOOT_UDEMY_DISCOVERY_RENDER_WAIT_MS=3500