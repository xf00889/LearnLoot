DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://course_deals:course_deals@127.0.0.1:5432/course_deals

CORS_ALLOWED_ORIGINS=http://localhost:3000

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Provider discovery. Keep access approval false until the provider's current
# terms, robots directives, and permitted automated-access method are reviewed.
LEARNLOOT_UDEMY_DISCOVERY_ACCESS_APPROVED=false
LEARNLOOT_UDEMY_DISCOVERY_SOURCE_URL=https://www.udemy.com/courses/free/
LEARNLOOT_UDEMY_DISCOVERY_MAX_PAGES=10
LEARNLOOT_UDEMY_DISCOVERY_ITEM_LIMIT=0
LEARNLOOT_UDEMY_DISCOVERY_RENDER_WAIT_MS=3500

# Publication eligibility. Phase 6 queues eligible courses but does not send
# Telegram messages.
LEARNLOOT_PUBLICATION_MIN_RATING=4.0
LEARNLOOT_PUBLICATION_MIN_REVIEWS=100
LEARNLOOT_PUBLICATION_MIN_SCORE=70
LEARNLOOT_PUBLICATION_MAX_COURSE_AGE_HOURS=24
LEARNLOOT_PUBLICATION_COOLDOWN_HOURS=168

# Telegram CHANNEL publication. The bot token is the automation credential;
# the destination is your channel. Add the bot as a channel administrator with
# permission to post messages. For a public channel, CHANNEL_ID may be
# @your_channel_username; a numeric channel id is also supported by Telegram.
# Never commit real credentials.
LEARNLOOT_TELEGRAM_ENABLED=false
LEARNLOOT_TELEGRAM_BOT_TOKEN=
LEARNLOOT_TELEGRAM_CHANNEL_ID=
LEARNLOOT_TELEGRAM_API_BASE_URL=https://api.telegram.org
LEARNLOOT_TELEGRAM_TIMEOUT_SECONDS=10
LEARNLOOT_TELEGRAM_MAX_RETRIES=3
LEARNLOOT_TELEGRAM_RETRY_BASE_SECONDS=30
LEARNLOOT_TELEGRAM_STALE_SEND_MINUTES=15
LEARNLOOT_PUBLIC_BASE_URL=http://localhost:3000