DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://course_deals:course_deals@127.0.0.1:5432/course_deals

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Provider discovery. Keep access approval false until the provider's current
# terms, robots directives, and permitted automated-access method are reviewed.
LEARNLOOT_UDEMY_DISCOVERY_ACCESS_APPROVED=false
LEARNLOOT_UDEMY_DISCOVERY_SOURCE_URL=https://www.udemy.com/courses/free/
LEARNLOOT_UDEMY_DISCOVERY_MAX_PAGES=10
LEARNLOOT_UDEMY_DISCOVERY_ITEM_LIMIT=0
LEARNLOOT_UDEMY_DISCOVERY_RENDER_WAIT_MS=3500

# Publication eligibility. Phase 6 queues eligible courses but does not send
# Telegram messages.
LEARNLOOT_PUBLICATION_MIN_RATING=4.0
LEARNLOOT_PUBLICATION_MIN_REVIEWS=100
LEARNLOOT_PUBLICATION_MIN_SCORE=70
LEARNLOOT_PUBLICATION_MAX_COURSE_AGE_HOURS=24
LEARNLOOT_PUBLICATION_COOLDOWN_HOURS=168

# Telegram CHANNEL publication. The bot token is the automation credential;
# the destination is your channel. Add the bot as a channel administrator with
# permission to post messages. For a public channel, CHANNEL_ID may be
# @your_channel_username; a numeric channel id is also supported by Telegram.
# Never commit real credentials.
LEARNLOOT_TELEGRAM_ENABLED=false
LEARNLOOT_TELEGRAM_BOT_TOKEN=
LEARNLOOT_TELEGRAM_CHANNEL_ID=
LEARNLOOT_TELEGRAM_API_BASE_URL=https://api.telegram.org
LEARNLOOT_TELEGRAM_TIMEOUT_SECONDS=10
LEARNLOOT_TELEGRAM_MAX_RETRIES=3
LEARNLOOT_TELEGRAM_RETRY_BASE_SECONDS=30
LEARNLOOT_TELEGRAM_STALE_SEND_MINUTES=15
LEARNLOOT_PUBLIC_BASE_URL=http://localhost:3000

# Outbound analytics. Repeated clicks from the same remote address/course inside
# this short window still redirect but only the first is counted. The address is
# HMACed only for the ephemeral cache key and is never stored in click_events.
LEARNLOOT_OUTBOUND_CLICK_DEDUPE_SECONDS=2

# Phase 10 production/runtime controls. Keep LEARNLOOT_ENVIRONMENT=development
# locally. Production deployments should copy these keys into secret/runtime
# configuration rather than committing real values.
LEARNLOOT_ENVIRONMENT=development
LEARNLOOT_LOG_LEVEL=INFO

# Shared Django cache. Leave blank to use process-local memory in development.
# Production should use a dedicated Redis logical DB/instance so click dedupe
# works consistently across multiple web processes.
LEARNLOOT_CACHE_URL=

# Persistent CMS media. In production, point MEDIA_ROOT at a persistent mounted
# volume (or replace local FileSystemStorage with an object-storage backend in a
# future deployment-specific phase) and explicitly acknowledge that storage is
# durable and backed up.
LEARNLOOT_MEDIA_ROOT=
LEARNLOOT_MEDIA_URL=/media/
LEARNLOOT_MEDIA_PERSISTENCE_CONFIRMED=false

# HTTPS/security settings. Enable only when the production HTTPS/proxy path is
# configured correctly. Trust X-Forwarded-Proto only when your own proxy strips
# incoming copies and sets the header itself.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_X_FORWARDED_PROTO=false

# Periodic automation is intentionally opt-in. Run exactly one Celery beat
# scheduler in production.
LEARNLOOT_AUTOMATION_ENABLED=false
LEARNLOOT_DISCOVERY_INTERVAL_MINUTES=60
LEARNLOOT_DISCOVERY_RUNNING_STALE_MINUTES=90
LEARNLOOT_TELEGRAM_MAINTENANCE_INTERVAL_MINUTES=5
